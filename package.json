{
  "name": "@snapbyte-dev/traw",
  "version": "1.0.0",
  "description": "Unofficial TypeScript port of PRAW",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snapbyte-dev/traw.git"
  },
  "homepage": "https://github.com/snapbyte-dev/traw#readme",
  "bugs": {
    "url": "https://github.com/snapbyte-dev/traw/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm clean && tsc --project tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:types",
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "coverage": "vitest run --coverage",
    "example:top-posts": "tsx examples/typescript-top-posts.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:types": "tsc --project tsconfig.types.json",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
